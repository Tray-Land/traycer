<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayCer.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Traycer" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Add a printer"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Add a printer">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Click="FindPrinters_Click" Text="Find printers on my network">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE721;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="AddByAddress_Click" Text="Add by address">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE774;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                AutomationProperties.Name="Refresh"
                Click="RefreshButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Refresh">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Network trouble; the cards keep their last readings underneath  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!--  Printers  -->
        <ScrollViewer
            x:Name="ListScroller"
            Grid.Row="2"
            Margin="0,0,-4,0"
            Padding="0,0,4,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PrinterList" Spacing="8" />
        </ScrollViewer>

        <!--  First run / no printers  -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            MaxWidth="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE749;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="No printers yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Add a printer and its progress shows right here, and on the tray icon."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="FindButton"
                HorizontalAlignment="Stretch"
                Click="FindPrinters_Click"
                Content="Find printers on my network"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                HorizontalAlignment="Stretch"
                Click="AddByAddress_Click"
                Content="Add by address" />
        </StackPanel>

        <!--  Footer  -->
        <Grid Grid.Row="3">
            <TextBlock
                x:Name="UpdatedText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
