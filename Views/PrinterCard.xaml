<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayCer.Views.PrinterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:TrayCer.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!--  The status dot and message color; theme resources so they follow the flyout's theme.  -->
            <VisualStateGroup x:Name="Tone">
                <VisualState x:Name="Neutral">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorNeutralBrush}" />
                        <Setter Target="MessageText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Active">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="MessageText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="MessageText.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="MessageText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="MessageText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Dim">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
                        <Setter Target="MessageText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button
            x:Name="CardButton"
            Click="CardButton_Click"
            Style="{StaticResource CardButtonStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Job preview, only for printers that serve one, built up as the print goes  -->
                <Border
                    x:Name="ThumbnailFrame"
                    Width="56"
                    Height="56"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <local:BuildPreview x:Name="Thumbnail" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="NameText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                x:Name="Dot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="StateText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        x:Name="JobText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />

                    <Grid
                        x:Name="ProgressRow"
                        Margin="0,4,0,2"
                        ColumnSpacing="8"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:PrintProgressBar x:Name="Progress" VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="PercentText"
                            Grid.Column="1"
                            MinWidth="32"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBlock
                        x:Name="TimeText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="MessageText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="FactsText"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <!--  Room for CompleteButton, which sits over this spot  -->
                    <Border
                        x:Name="CompleteSpacer"
                        Height="32"
                        Margin="0,6,0,0"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Button>

        <!--  Scraped off the card when the print is marked complete  -->
        <local:PlateWipe x:Name="Wipe" />

        <!--  Over the card rather than in it: a button can't hold a button. The margin is the card's padding plus border.  -->
        <Button
            x:Name="CompleteButton"
            Height="32"
            Margin="0,0,13,11"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="Mark as complete"
            Click="CompleteButton_Click"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE73E;" />
                <TextBlock Text="Mark as complete" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
