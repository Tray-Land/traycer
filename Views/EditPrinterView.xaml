<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayCer.Views.EditPrinterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Margin="-8,0,0,0"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Add printer" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,-4,0"
            Padding="0,0,4,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="HostBox"
                            Header="Address"
                            InputScope="Url"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="192.168.1.50 or printer.local"
                            TextChanged="HostBox_TextChanged" />
                        <Button
                            x:Name="DetectButton"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Detect the printer type"
                            Click="DetectButton_Click"
                            IsEnabled="False">
                            <Grid>
                                <TextBlock x:Name="DetectLabel" Text="Detect" />
                                <ProgressRing
                                    x:Name="DetectRing"
                                    Width="16"
                                    Height="16"
                                    IsActive="False" />
                            </Grid>
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="DetectText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Detect works out the printer type from the address."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <ComboBox
                        x:Name="KindBox"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="DisplayName"
                        Header="Printer type"
                        PlaceholderText="Choose a type"
                        SelectionChanged="KindBox_SelectionChanged" />
                    <TextBlock
                        x:Name="CoversText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  Everything below depends on the type; each field shows only for types that need it.  -->
                <StackPanel
                    x:Name="KindFields"
                    Spacing="14"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="NameBox"
                        Header="Name"
                        PlaceholderText="Shown on the card and in alerts" />

                    <StackPanel x:Name="SerialPanel" Spacing="4">
                        <TextBox
                            x:Name="SerialBox"
                            CharacterCasing="Upper"
                            IsSpellCheckEnabled="False" />
                        <TextBlock
                            x:Name="SerialHelp"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="UsernamePanel" Spacing="4">
                        <TextBox
                            x:Name="UsernameBox"
                            Header="User name"
                            IsSpellCheckEnabled="False"
                            Text="maker" />
                    </StackPanel>

                    <StackPanel x:Name="SecretPanel" Spacing="4">
                        <PasswordBox x:Name="SecretBox" />
                        <TextBlock
                            x:Name="SecretHelp"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="SlugPanel" Spacing="4">
                        <TextBox
                            x:Name="SlugBox"
                            Header="Printer slug"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="Optional" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Leave it empty to follow the server's first printer."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <InfoBar
                    x:Name="ResultBar"
                    IsClosable="True"
                    IsOpen="False" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="TestButton"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Test connection"
                Click="TestButton_Click">
                <Grid>
                    <TextBlock x:Name="TestLabel" Text="Test connection" />
                    <ProgressRing
                        x:Name="TestRing"
                        Width="16"
                        Height="16"
                        IsActive="False" />
                </Grid>
            </Button>
            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
